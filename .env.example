# Postgres connection string. Locally: your own Postgres. In production: Neon (free tier).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invite

# Password for the host dashboard at /admin
ADMIN_PASSWORD=change-me

# Optional: the public address of the site, e.g. https://my-graduation.vercel.app
# Used for invitation links and WhatsApp previews. Auto-detected when unset.
NEXT_PUBLIC_SITE_URL=
