# Copy this file to .env and uncomment what you need. Everything is optional locally.

# Leave unset to use the built-in local database in .data/ (no setup needed).
# Set it to use a real Postgres database; required in production (e.g. your Neon connection string).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional direct Neon connection string for running migrations.
# DATABASE_URL_UNPOOLED=

# Initial system owner password at /admin. Username is "owner" on first login.
# The owner must choose a new username and password immediately. This value is not used after setup.
# Locally it defaults to "admin"; required for a new production installation.
# ADMIN_PASSWORD=change-me

# Optional: the public address of the site, e.g. https://graduation-invite.onrender.com
# Used for invitation links and WhatsApp previews. Auto-detected when unset.
# NEXT_PUBLIC_SITE_URL=
